# Copy to release.env (gitignored) and fill in. scripts/release.sh sources it.
# Values already set in the environment take precedence over this file.

# Release signing keystore. Generate it once with `mise run keystore`.
# Keep it outside the repository and back it up: if it is lost, every
# Obtainium user has to uninstall and reinstall the app.
NIGHTLY_KEYSTORE_FILE="$HOME/.config/t3code-android-nightly/release.keystore"
NIGHTLY_KEYSTORE_PASSWORD=""
NIGHTLY_KEY_ALIAS="t3code-nightly"
# PKCS12 keystores use the store password for the key; leave empty for that.
NIGHTLY_KEY_PASSWORD=""

# Optional overrides.
# Set to 0 to build without T3 Connect (same as --no-t3-connect).
# NIGHTLY_T3_CONNECT=1
# Comma-separated ABIs to build native code for (armeabi-v7a, arm64-v8a, x86,
# x86_64). Each extra ABI adds several minutes to the build.
# NIGHTLY_ARCHITECTURES="arm64-v8a"
# Set to 0 to build at normal priority instead of idle priority (faster on a
# busy machine, but the desktop becomes sluggish).
# NIGHTLY_IDLE=1
# NIGHTLY_REPO="DanielSintimbrean/t3code-android-nightly"
# NIGHTLY_UPSTREAM_URL="https://github.com/pingdotgg/t3code.git"
# NIGHTLY_CACHE_DIR="$HOME/.cache/t3code-android-nightly"
